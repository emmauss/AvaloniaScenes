<Scene xmlns="https://github.com/avaloniaui"
       xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
       xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
       xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
       xmlns:vm="using:SceneSample.Mvvm.ViewModels"
       mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="450"
       x:DataType="vm:SampleViewModel"
       TopLevel.AutoSafeAreaPadding="True"
       x:Class="SceneSample.Mvvm.Scenes.SampleScene">
    <Grid RowDefinitions="*,Auto">
        <Border BorderBrush="Green" BorderThickness="1"
                HorizontalAlignment="Stretch"
                VerticalAlignment="Stretch">
            <Image Stretch="Uniform"
                   Source="{Binding LoadedImage}"
                   VerticalAlignment="Center"
                   HorizontalAlignment="Center"/>
        </Border>
        <Button Content="Close" 
                Name="CloseButton"
                Click="CloseButton_Click"
                HorizontalAlignment="Center" 
                VerticalAlignment="Bottom"/>
    </Grid>
</Scene>
